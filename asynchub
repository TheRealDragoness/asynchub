function UIitemSetup:SetupItems(UI)
	for _, v in pairs(UI:GetDescendants()) do
		if TagService:HasTag(v, "Item") then
			local ItemType = v:GetAttribute("ItemType")
			if ItemType == "ToggleSlider" then
				UIitemSetup:InitToggleSlider(v)
			end
			if ItemType == "TextBox" then
				UIitemSetup:InitTextBox(v)
			end
			if ItemType == "Button" then
				UIitemSetup:InitButton(v)
			end
		end
	end
end

function UIitemSetup:InitButton(object)
	local button = object:FindFirstChild("ActualButton")

	local isActive = false
	local function Update()
		object:SetAttribute("Activated",isActive)
	end

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 
			or input.UserInputType == Enum.UserInputType.Touch then

			isActive = true
			Update()
		end
	end)

	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 
			or input.UserInputType == Enum.UserInputType.Touch then

			isActive = false
			Update()
		end
	end)
end

function UIitemSetup:InitTextBox(object)
	local TextBox = object:FindFirstChild("TextBox")
	local text = TextBox.Text
	object:SetAttribute("Output",text)
	
	TextBox.Changed:Connect(function()
		text = TextBox.Text
		object:SetAttribute("Output",text)
	end)
end

function UIitemSetup:InitToggleSlider(object)
	local DefaultPosition = object:GetAttribute("DefaultPosition")
	local Position = DefaultPosition
	
	local PositionType = "off"
	if DefaultPosition == true then
		PositionType = "on"
	end
	
	local toggleObject = object:FindFirstChild(PositionType):Clone()
	toggleObject.Parent = object
	toggleObject.Name = "ToggleObject"
	toggleObject.Visible = true
	
	local Debounce = false
	local function Toggle()
		local ColorInfo = TweenInfo.new(0.5/2,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut)
		local SliderInfo = TweenInfo.new(0.75/2,Enum.EasingStyle.Linear,Enum.EasingDirection.Out)
		if Position == true then
			local ColorTween = TS:Create(object,ColorInfo,{
				BackgroundColor3 = Color3.fromRGB(0, 179, 0)
			}):Play()
		else
			local ColorTween = TS:Create(object,ColorInfo,{
				BackgroundColor3 = Color3.fromRGB(212, 0, 0)
			}):Play()
		end
		local pType = "off"
		if Position == true then
			pType = "on"
		end
		
		local SliderTween = TS:Create(toggleObject,SliderInfo,{
			Position = object:FindFirstChild(pType).Position
		}):Play()
		object:SetAttribute("Position",Position)
	end
	Toggle()
	
	local ActualButton = object:FindFirstChild("ActualButton")
	ActualButton.Activated:Connect(function()
		if Debounce then return end
		Debounce = true
		task.delay(0.4,function()
			Debounce = false
		end)
		
		Position = not Position
		Toggle()
	end)
end

function UIitemSetup:GetItemChangeSignal(object, objectType)
	local outputType

	if objectType == "ToggleSlider" then
		outputType = "Position"
	elseif objectType == "TextBox" then
		outputType = "Output"
	elseif objectType == "Button" then
		outputType = "Activated"
	end

	local bindable = Instance.new("BindableEvent")

	object:GetAttributeChangedSignal(outputType):Connect(function()
		local value = object:GetAttribute(outputType)
		bindable:Fire(value)
	end)

	return bindable.Event
end

return UIitemSetup
end;
