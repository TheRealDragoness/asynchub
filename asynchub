function ItemFunction:Clear()
	for i, v in ipairs(items) do
		if typeof(v) == "RBXScriptConnection" then
			if v.Connected then
				v:Disconnect()
			end

		elseif typeof(v) == "Instance" then
			if v.Parent then
				v:Destroy()
			end

		elseif type(v) == "function" then
			-- optional: allow custom cleanup functions
			v()

		elseif type(v) == "table" then
			-- if you ever store objects with a Destroy/Cleanup method
			if v.Destroy then
				v:Destroy()
			elseif v.Cleanup then
				v:Cleanup()
			end
		end

		items[i] = nil
	end
end

return ItemFunction
end;
