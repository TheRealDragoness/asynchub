				FloaterPart.Position = Pos
				SpawnFloater()
			end)
		end)

		items[#items+1] = UIS.InputBegan:Connect(function(input,isTyping)
			if not isTyping then
				if input.KeyCode == Enum.KeyCode.Up then
					y += 2.2
				end
				if input.KeyCode == Enum.KeyCode.Down then
					y -= 2.2
				end
			end
		end)
		
		items[#items+1] = UIitemSetup:GetItemChangeSignal(item:FindFirstChild("up"), "Button"):Connect(function(val)
			if not val then return end
			y += 2.2
		end)
		items[#items+1] = UIitemSetup:GetItemChangeSignal(item:FindFirstChild("down"), "Button"):Connect(function(val)
			if not val then return end
			y -= 2.2
		end)
	end
	
	UIitemSetup:GetItemChangeSignal(item:FindFirstChild("toggle"), "ToggleSlider"):Connect(function(val)
		if val then
			Enable()
		else
			ItemFunction:Clear()
		end
	end)
	
