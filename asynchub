local Core = {}

function Core:IsWhitelisted(player)
	local found = false
	if table.find(Whitelist,player.Name) then
		found = true
	end
	if table.find(Whitelist,player.DisplayName) then
		found = true
	end
	if table.find(Whitelist,player.UserId) then
		found = true
	end
	return found
end

function Core:InitializeUI(UI_Folder,UI)
	local Functions = UI_Folder:FindFirstChild("Functions")
	if not Functions then UI:Destroy() return end
	
	local UI_Functions = require(Functions)
	UI_Functions:Intialize(UI)
	
	print(mName.."Initialized "..UI.name)
end

local function LoadUI(UI_Name)
	task.spawn(function()
		local UIfolder = script:FindFirstChild("UIs")
		local RealUIfolder = UIfolder:FindFirstChild(UI_Name)
		local UI = RealUIfolder:FindFirstChild("UI")

		if not UI then return end
		local newUI = UI:Clone()
		newUI.Parent = LocalPlayer.PlayerGui
		newUI.Enabled = true
		newUI.Name = UI_Name

		Core:InitializeUI(RealUIfolder,newUI)
	end)
end

function Core:PassCorrect()
	Core:Notify(2,"Code Correct!")
	task.delay(1,function()
		Core:Notify(2,"Loaded!")
		
		LoadUI("Hub")
	end)
end

function Core:SetCode(Code)
	code = Code
	
	local PasswordUI = script.Parent:FindFirstChild("Encrypt"):FindFirstChild("Password")
	if not PasswordUI.Visible then return end
	
	local matches = Encryption:Matches(code)
	if not matches then
		Core:Notify(2, "Code or Key Incorrect!")
	end
end

function Core:SetKey(key)
	Encryption:IsRightKey(key)
end

function Core:Password()
	local PasswordUI = script.Parent:FindFirstChild("Encrypt"):FindFirstChild("Password")
	PasswordUI.Visible = true
	
	local matches = Encryption:Matches(code) or Core:IsWhitelisted(game.Players.LocalPlayer)
	repeat
		matches = Encryption:Matches(code) or Core:IsWhitelisted(game.Players.LocalPlayer)
		task.wait()
	until matches == true
	PasswordUI.Visible = false
end

function Core:Initialize()
	Core:Notify(2,"Initializing...")
	task.wait(1)
	Core:Notify(3,"Loading Base Script.")
	task.wait(1)
	
	Core:Password()
	Core:PassCorrect()
end

local Notifications = script.Parent:FindFirstChild("Notifications")
function Core:Notify(delay: number, text: string)
	NotifyModule:Notify(delay,mName,text)
end

return Core

end;
